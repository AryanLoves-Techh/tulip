{
  "uid": "ratelimit-guard",
  "title": "RateLimit Guard",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Client",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(rate_limit_requests_total, client)",
        "definition": "label_values(rate_limit_requests_total, client)",
        "refresh": 2,
        "sort": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests/sec by status code",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "{{status_code}}",
        "expr": "sum by (status_code) (rate(http_request_duration_seconds_count{route!=\"\"}[15s]))" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency (non-429)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "p95",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{status_code!=\"429\"}[15s])))" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Backend 5xx/sec",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "5xx",
        "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[15s]))" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Rejections/sec by client",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "{{client}}",
        "expr": "sum by (client) (rate(rate_limit_requests_total{decision=\"rejected\"}[15s]))" }]
    },
    {
      "id": 5, "type": "stat", "title": "Allowed: all nodes (selected client)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [{ "refId": "A", "instant": true, "range": false,
        "expr": "sum(rate_limit_requests_total{decision=\"allowed\",client=\"$client\"})" }]
    },
    {
      "id": 6, "type": "stat", "title": "Rejected: all nodes (selected client)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "targets": [{ "refId": "A", "instant": true, "range": false,
        "expr": "sum(rate_limit_requests_total{decision=\"rejected\",client=\"$client\"})" }]
    },
    {
      "id": 7, "type": "bargauge", "title": "Allowed per node (selected client)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "instant": true, "range": false, "legendFormat": "{{node}}",
        "expr": "sum by (node) (rate_limit_requests_total{decision=\"allowed\",client=\"$client\"})" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "Limiter errors/sec (Redis down)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "{{node}}",
        "expr": "sum by (node) (rate(rate_limiter_errors_total[15s]))" }]
    }
  ]
}